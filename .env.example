# Copy to `.env` and fill in. `.env` is git-ignored; this file is tracked.
#   cp .env.example .env
#
# Real environment variables override `.env`, so you can export a value to
# shadow the file without editing it.
# Inspect what actually loaded (values masked) with: uv run pc config

# --- Credentials -------------------------------------------------------------

# https://console.anthropic.com/settings/keys
# Used for extraction and narration.
ANTHROPIC_API_KEY=

# https://www.courtlistener.com/profile/api/
# Corpus sourcing. Authenticated budget is 5 req/min, 50/hour, 125/day —
# unauthenticated is far lower, so this is effectively required.
COURTLISTENER_API_TOKEN=

# --- Storage -----------------------------------------------------------------

# Only the API and demo cache need this; the engine runs without a database.
DATABASE_URL=postgresql+asyncpg://localhost:5432/policycheck

# --- Pipeline ----------------------------------------------------------------

# Do not downgrade to save cost — extraction accuracy is the product.
EXTRACTION_MODEL=claude-opus-5

# Spec §10. Two independent passes; disagreements become `low` confidence.
# Setting this to 1 makes the needs_review bucket dishonest.
EXTRACTION_PASSES=2

# Spec invariant 5: documents processed in memory and discarded.
DEMO_MODE=true

# Run-scoped raster cache. Cleared when a run ends, including on failure.
RASTER_CACHE_DIR=.raster_cache
